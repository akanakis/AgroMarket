# Copy this file to .env.docker and fill in real values before running docker-compose
# NEVER commit .env.docker to version control
# Generate secrets: openssl rand -hex 32

# ==================== DATABASE ====================
POSTGRES_USER=agromarket
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=agromarket

# ==================== BACKEND ====================
# Must match POSTGRES_USER/POSTGRES_PASSWORD above
DATABASE_URL=postgresql://agromarket:change_me_strong_password@db:5432/agromarket
# Generate with: openssl rand -hex 32  (must be at least 32 chars)
SECRET_KEY=change_me_to_a_random_64_char_string_use_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://yourdomain.com
REDIS_URL=redis://redis:6379
# Set to true when running behind HTTPS (enables Secure flag on cookies)
PRODUCTION=true

# ==================== FRONTEND ====================
NEXT_PUBLIC_API_URL=https://yourdomain.com/api/v1
# Google Gemini API key (server-side only — never use NEXT_PUBLIC_ prefix)
GEMINI_API_KEY=your_gemini_api_key_here
